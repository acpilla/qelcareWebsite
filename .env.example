# ============================================================================
# QELCare FRONTEND environment  (my-app/.env)  — copy to `.env`
# ----------------------------------------------------------------------------
# cp .env.example .env  then fill in values.  NEVER commit `.env`.
# Create React App only exposes variables prefixed with REACT_APP_.
# Restart `npm start` after changing this file.
# ============================================================================

# Dev server port for the React app.
PORT=3000

# Base URL of the QELCare backend API (no trailing slash).
# Local default matches qelcare-backend PORT (5001).
REACT_APP_API_URL=http://localhost:5001
