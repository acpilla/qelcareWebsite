# ============================================================================
# QELCare FRONTEND — production build env  (my-app/.env.production)
# ----------------------------------------------------------------------------
# This file IS committed (only `.env*.local` and bare `.env` are gitignored), so
# Vercel's `react-scripts build` reads it. It intentionally does NOT set
# REACT_APP_API_URL — that stays sourced from Vercel's dashboard env (or `.env`).
# ============================================================================

# Emit the CRA/webpack runtime as an external, same-origin file
# (/static/js/runtime-main.*.js) instead of inlining a <script> into index.html.
# This is what lets the Content-Security-Policy use `script-src 'self'` with NO
# 'unsafe-inline' — an inline runtime chunk would otherwise be blocked by the CSP
# (white screen). Do not remove without also loosening script-src.
INLINE_RUNTIME_CHUNK=false
